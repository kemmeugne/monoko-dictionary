      "french": "Tu es malade ?",
      "dialect": "Ozo bela ?"
    },
    {
      "id": 7332,
      "item_order": 14,
      "french": "Je me sens mal",
      "dialect": "Nzoto eza malamu te."
    },
    {
      "id": 7333,
      "item_order": 15,
      "french": "Il est mort",
      "dialect": "Akufi"
    },
    {
      "id": 7334,
      "item_order": 16,
      "french": "Qu'est-ce qu'il y a ? Qu'est-ce qu'il se passe ?",
      "dialect": "Nini kaka ? Nini ezo leka ?"
    },
    {
      "id": 7335,
      "item_order": 17,
      "french": "C'est pas grave",
      "dialect": "Eza motuya te."
    },
    {
      "id": 7336,
      "item_order": 18,
      "french": "J'arrive",
      "dialect": "Na zo yaka."
    },
    {
      "id": 7337,
      "item_order": 19,
      "french": "J'ai faim",
      "dialect": "Naza na nzala."
    },
    {
      "id": 7338,
      "item_order": 20,
      "french": "J'ai soif",
      "dialect": "Na za na posa ya ko mela."
    },
    {
      "id": 7339,
      "item_order": 21,
      "french": "Tu veux manger quoi ? Boire quoi ?",
      "dialect": "Olingi kolia nini ? Ko mela nini ?"
    },
    {
      "id": 7340,
      "item_order": 22,
      "french": "J'ai bien mangé",
      "dialect": "Na lie malamu."
    },
    {
      "id": 7341,
      "item_order": 23,
      "french": "J'ai besoin d'aide / Est-ce que tu peux m'aider stp ?",
      "dialect": "Na za na mposa lisungi / Okoki ko sunga ngai limbisa ?"
    },
    {
      "id": 7342,
      "item_order": 24,
      "french": "Merci de m'avoir aidé",
      "dialect": "Matondo po osungi ngai."
    },
    {
      "id": 7343,
      "item_order": 25,
      "french": "Vous parlez français ?",
      "dialect": "Olobaka falanse ?"
    },
    {
      "id": 7344,
      "item_order": 26,
      "french": "Je n'ai pas compris",
      "dialect": "Na sosoli te."
    },
    {
      "id": 7345,
      "item_order": 27,
      "french": "Tu peux parler plus lentement stp ? Tu parles trop vite",
      "dialect": "Limbisa, okoki ko loba malembe koleka ? Ozo loba mbangu mingi."
    },
    {
      "id": 7346,
      "item_order": 28,
      "french": "Comment on dit « merci (ou autre mot français) » en lingala ?",
      "dialect": "Ndenge nini ba lobaka « Merci » na lingala ?"
    },
    {
      "id": 7347,
      "item_order": 29,
      "french": "Qu'est-ce que ça veut dire ?",
      "dialect": "Elingi ko loba nini ?"
    },
    {
      "id": 7348,
      "item_order": 30,
      "french": "Tu comprends ? / Tu as compris ?",
      "dialect": "Ozo sosola ?/ Ososoli ?"
    },
    {
      "id": 7349,
      "item_order": 31,
      "french": "Qu'est-ce que ça veut dire ?",
      "dialect": "Elakisi nini ?"
    },
    {
