      "french": "À cause de",
      "dialect": "Pona"
    },
    {
      "id": 7683,
      "item_order": 139,
      "french": "Ils se sont fâchés à cause de nous",
      "dialect": "Ba siliki pona biso."
    },
    {
      "id": 7684,
      "item_order": 140,
      "french": "Beaucoup",
      "dialect": "Ebele"
    },
    {
      "id": 7685,
      "item_order": 141,
      "french": "Elle a épluché beaucoup de bananes",
      "dialect": "Alongoli poso na makemba ebele."
    },
    {
      "id": 7686,
      "item_order": 142,
      "french": "Vous avez beaucoup fait pour nous, merci.",
      "dialect": "Bo sali mingi pona biso, matondo."
    },
    {
      "id": 7687,
      "item_order": 143,
      "french": "Très",
      "dialect": "Penza"
    },
    {
      "id": 7688,
      "item_order": 144,
      "french": "Elle a très bien cuisiné",
      "dialect": "Alambi malamu penza."
    },
    {
      "id": 7689,
      "item_order": 145,
      "french": "Trop",
      "dialect": "Mingi"
    },
    {
      "id": 7690,
      "item_order": 146,
      "french": "Peu",
      "dialect": "Mokie"
    },
    {
      "id": 7691,
      "item_order": 147,
      "french": "Prends un peu de sauce, voici la cuillère.",
      "dialect": "Zwa supu mokie, tala lutu."
    },
    {
      "id": 7692,
      "item_order": 148,
      "french": "Elle est timide, elle sourit un peu quand je la taquine.",
      "dialect": "Aza kimia, asekaka mokie soki na tumboli ye."
    },
    {
      "id": 7693,
      "item_order": 149,
      "french": "Tellement",
      "dialect": "Mingi"
    },
    {
      "id": 7694,
      "item_order": 150,
      "french": "Elle est tellement belle qu'elle nous rend tous bêtes",
      "dialect": "Aza kitoko mingi akomisaka biso nionso ba zoba."
    },
    {
      "id": 7695,
      "item_order": 151,
      "french": "Environ",
      "dialect": "Na"
    },
    {
      "id": 7696,
      "item_order": 152,
      "french": "Vraiment",
      "dialect": "Penza"
    },
    {
      "id": 7697,
      "item_order": 153,
      "french": "Aussi",
      "dialect": "Pe"
    },
    {
      "id": 7698,
      "item_order": 154,
      "french": "Nous vivons à Pointe-Noire. Elle aussi.",
      "dialect": "To fandaka na Pointe-Noire. Na ye pe."
    },
    {
      "id": 7699,
      "item_order": 155,
      "french": "Elle est aussi grande que toi.",
      "dialect": "Aza molayi lokola yo."
    },
    {
      "id": 7700,
      "item_order": 156,
      "french": "Même",
      "dialect": "Ata"
    },
    {
      "id": 7701,
      "item_order": 157,
      "french": "Elle porte la même robe que moi",
      "dialect": "Alati lopo moko na ngai."
    },
    {
      "id": 7702,
      "item_order": 158,
      "french": "Même si elle n'aime pas la nourriture elle mange quand même",
      "dialect": "Ata alingi bilia te aliaka kaka."
    },
    {
      "id": 7703,
      "item_order": 159,
      "french": "Je ne ferai jamais ça même si tu me payes",
      "dialect": "Na ko sala yango te ata ofuti ngai."
    },
    {
      "id": 7704,
      "item_order": 160,
      "french": "Elle est quand même venue au deuil malgré qu'elle ne parle plus à sa famille.",
      "dialect": "Aye kaka na matanga ata alobisaka lisusu libota na ye te."
    },
    {
      "id": 7705,
      "item_order": 161,
      "french": "Autre",
      "dialect": "Mosusu"
    },
    {
      "id": 7706,
      "item_order": 162,
      "french": "Il faut penser aux autres",
      "dialect": "Esengeli ko kanisa na ba misusu."
    },
    {
      "id": 7707,
      "item_order": 163,
      "french": "Va dire ça à quelqu'un d'autre",
      "dialect": "Kende oloba yango na moto mosusu."
    },
    {
      "id": 7708,
      "item_order": 164,
      "french": "Certaines personnes aiment les chiens, d'autres aiment les chats",
      "dialect": "Bato mosusu ba lingi ba mbwa, misusu ba lingi ba niao."
    },
    {
      "id": 7709,
      "item_order": 165,
      "french": "Presque",
      "dialect": "Esi kaka"
    },
    {
      "id": 7710,
      "item_order": 166,
      "french": "Je suis presque tombé (j'ai failli tomber)",
      "dialect": "Na lingaki na kweya."
    },
    {
