# Copy to .env.test (gitignored) and fill in real values.
# Get these from the monoko-test Supabase project dashboard.
# Never point any of these at the production project.

SUPABASE_URL=https://your-test-project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Session pooler connection string (Connect -> Session pooler in the
# dashboard). Direct connection is IPv6-only and times out on most home
# networks -- use the pooler. Only needed for scripts/sync_test_schema.js.
TEST_SUPABASE_DB_URL=postgresql://postgres.your-test-project-ref:PASSWORD@aws-X-region.pooler.supabase.com:5432/postgres

# Required by scripts/seed_test_data.js -- no hardcoded fallback in source.
TEST_USER_EMAIL=test@monoko.app
TEST_USER_PASSWORD=
